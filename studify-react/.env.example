# Copiá este archivo como ".env" y completá los valores. El .env NO se sube a GitHub.

# API de Wikipedia (opcional: si no está, se usa la Wikipedia en español)
VITE_API_URL=https://es.wikipedia.org/w/api.php

# Asistente con IA. Las claves van SIN el prefijo VITE_, así el navegador nunca las ve.
# Proveedor: gemini (por defecto, gratis), groq (gratis) o anthropic (Claude, pago)
AI_PROVIDER=gemini

# Gemini: clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo opcional (por defecto gemini-3.8-flash)
GEMINI_MODEL=

# Groq (opcional): clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# Claude (opcional): clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
